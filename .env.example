# Referência: defina variáveis na sessão PowerShell antes de iniciar.
# O aplicativo não carrega .env automaticamente.
# Nunca grave uma chave real em arquivo versionado.
AUTOAPPLY_PORT=5000
# AUTOAPPLY_DATA_DIR=C:/Users/SEU_USUARIO/.autoapply
# AUTOAPPLY_LLM_API_KEY=configure-na-sessao-ou-no-cofre
# AUTOAPPLY_LLM_PROVIDER=openai
# AUTOAPPLY_LLM_ENDPOINT=https://servidor-compativel.example/v1
# Alternativa restrita ao destino oficial correspondente:
# OPENAI_API_KEY=configure-na-sessao-ou-no-cofre
# ANTHROPIC_API_KEY=configure-na-sessao-ou-no-cofre
# GOOGLE_API_KEY=configure-na-sessao-ou-no-cofre
# DEEPSEEK_API_KEY=configure-na-sessao-ou-no-cofre
